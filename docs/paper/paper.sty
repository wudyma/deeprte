% %% This code creates the groups
% % -----------------------------------------
\usepackage{etoolbox}
\usepackage{framed} % Framing content
\usepackage{multicol}
\renewcommand{\nompreamble}{\begin{multicols}{2}} % 开始多列环境
    \renewcommand{\nompostamble}{\end{multicols}}    % 结束多列环境
\setlength{\nomitemsep}{-0.5ex} % 行距（范围：-2ex到1ex）

% If group omitted, falls back to Z group.
\makeatletter
% Define per-group counters lazily (T and N predefined). You can add more groups if needed.
\@ifundefined{c@nom@A}{\newcounter{nom@A}}{}
\@ifundefined{c@nom@N}{\newcounter{nom@N}}{}
% Hidden default group counter
\@ifundefined{c@nom@Z}{\newcounter{nom@Z}}{}

% Zero-pad helper (3 digits). Adapt if >999 entries expected per group.
\newcommand*{\nom@padthree}[1]{\ifnum#1<10 00\else\ifnum#1<100 0\fi\fi}

\let\nom@orig@nomenclature\nomenclature
\renewcommand{\nomenclature}[3][]{%
  % #1 = group letter like T / N. If empty, use Z.
  \def\nom@group{#1}%
  \ifx\nom@group\@empty\def\nom@group{Z}\fi
  % Increment appropriate counter
  \@ifundefined{c@nom@\nom@group}{% create counter on first use
    \expandafter\newcounter\csname nom@\nom@group\endcsname
  }{}
  \stepcounter{nom@\nom@group}%
  % Compose zero-padded index
  \edef\nom@idx{\nom@padthree{\value{nom@\nom@group}}\arabic{nom@\nom@group}}%
  % Sort key = group letter + index so groups stay clustered, internal order preserved
  \edef\nom@sortkey{\nom@group\nom@idx}%
  \nom@orig@nomenclature[\nom@sortkey]{#2}{#3}%
}
\makeatother

% (Re)define group title formatting if using same letters T/N etc.
% Example: show custom headers for T and N only. Adjust as needed.
\renewcommand\nomgroup[1]{\item[\bfseries
              \ifstrequal{#1}{A}{Theoretical Symbols}{\ifstrequal{#1}{N}{Numerical Symbols}{}}]}%